# FORK: Voka CRM — produção. Copie para .env e preencha.
DOMAIN=app.vokacrm.com.br
ACME_EMAIL=voce@seudominio.com.br

# Gere com: openssl rand -base64 48
APP_SECRET=
# Gere com: openssl rand -hex 24
PG_PASSWORD=

IS_MULTIWORKSPACE_ENABLED=false

# SMTP transacional (Resend/SES/Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=nao-responda@vokacrm.com.br

# CAPTCHA (Cloudflare Turnstile recomendado — gratuito)
CAPTCHA_DRIVER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Hetzner Object Storage (backups)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=zellate-backups
